# edu-agent 환경변수 템플릿 — 복사해서 .env 로 쓰고 실제 값을 채운다.
#   cp .env.example .env
# 비밀값(키)은 절대 커밋하지 않는다.

# ── LLM ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# true: 로컬 Claude CLI(구독 인증) 사용 / false: ANTHROPIC_API_KEY 로 API 직접 호출
USE_LOCAL_CLAUDE=true
# CLI 모드 사용 모델 고정(없으면 구독 기본 모델로 돌아 비싸짐)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Langfuse (LLM 추적, 비우면 비활성) ──
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://langfuse.luxrobo.net

# ── Sentry (에러/성능/부하 관측, 비우면 비활성) ──
# DSN 은 self-hosted sentry.luxrobo.net 의 edu-agent 프로젝트 공개 인입 키.
SENTRY_DSN=
# 배포 환경: dev | onprem(사내서버) | release(클라우드 실서버)
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_RELEASE=
# 사설 CA/TLS 인터셉션 환경에서만 ca 번들 경로 지정
SENTRY_CA_CERTS=

# ── 배포/런타임 ──
# 멀티워커 분산 세션 락(S1). docker-compose 는 redis 서비스로 자동 주입.
REDIS_URL=
# uvicorn 워커 수
WEB_CONCURRENCY=1
# 세션 저장소 TTL/최대 개수
SESSION_TTL_SECONDS=86400
SESSION_MAX=500
