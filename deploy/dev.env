# edu-agent — dev 환경 오버레이 (개발/로컬 검증용)
#
# docker-compose 가 .env(공통+비밀) 다음에 이 파일을 덮어쓴다.
#   EDU_AGENT_ENV_FILE=deploy/dev.env docker compose up -d --build
#
# LLM 키(ANTHROPIC/GEMINI)·Claude 구독 인증은 여기 넣지 않는다 — .env(또는 시크릿 매니저)에만.
# 관측 키(SENTRY_DSN, LANGFUSE_*)는 배포마다 누락되지 않도록 여기 오버레이에 둔다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
# 개발은 트래픽이 적으니 전수 추적/프로파일 — 성능 이슈를 빠짐없이 본다.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# ── Langfuse (LLM 추적) — self-hosted langfuse.luxrobo.net / 단일 인스턴스(3환경 공통) ──
# Sentry 와 동일하게 배포 오버레이로 관리한다 → 서버 .env 누락과 무관하게 항상 주입.
# (SECRET_KEY 는 비공개 키다. 시크릿 매니저로 옮기려면 이 블록을 지우고 서버 시크릿 주입으로 대체.)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://langfuse.luxrobo.net
