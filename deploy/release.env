# edu-agent — release 환경 오버레이 (클라우드 실서버, 향후 프로덕션)
#
# 클라우드 배포 시:
#   EDU_AGENT_ENV_FILE=deploy/release.env docker compose up -d --build
#
# LLM 키(ANTHROPIC/GEMINI)·Claude 구독 인증은 .env/시크릿 매니저에만.
# 관측 키(SENTRY_DSN, LANGFUSE_*)는 배포마다 누락되지 않도록 여기 오버레이에 둔다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=release
# 실서버는 트래픽이 늘 수 있어 성능 트랜잭션을 표본만 수집(비용/노이즈 제어). 필요시 조정.
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# ── Langfuse (LLM 추적) — self-hosted langfuse.luxrobo.net / 단일 인스턴스(3환경 공통) ──
# Sentry 와 동일하게 배포 오버레이로 관리한다 → 서버 .env 누락과 무관하게 항상 주입.
# (SECRET_KEY 는 비공개 키다. 시크릿 매니저로 옮기려면 이 블록을 지우고 서버 시크릿 주입으로 대체.)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://langfuse.luxrobo.net
