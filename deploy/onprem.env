# edu-agent — onprem 환경 오버레이 (사내 서버, 현재 운영)
#
# docker-compose 기본 오버레이. 별도 지정 없이 `docker compose up -d` 하면 이 파일이 적용된다.
#   docker compose up -d --build
#
# LLM 키(ANTHROPIC/GEMINI)·Claude 구독 인증은 .env/마운트에만.
# 관측 키(SENTRY_DSN, LANGFUSE_*)는 배포마다 누락되지 않도록 여기 오버레이에 둔다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=onprem
# 샘플링 하향(2026-08-21) — "사내 트래픽은 많지 않아 전수 유지" 전제가 40명 동시
# 수업에서 깨졌다. 이 Sentry 는 **같은 박스에서 self-hosted 로 돌고**(컨테이너 60여 개),
# 전수 추적/프로파일이면 요청 40건이 트레이스 40 + 프로파일 40 을 만들어 같은 16코어가
# relay→kafka→snuba→clickhouse 로 처리한다. 부하가 스스로를 증폭시키는 구조다.
#
# 실측 근거(2026-08-21 09:37:54, dmesg):
#   Out of memory: Killed process 58954 (sentry) anon-rss:11619828kB
# 동접 40 부하 구간에 Sentry 프로세스가 11.6GB 를 쓰다 호스트 OOM 으로 죽었고,
# 그 시각 edu-agent /health 가 19회 무응답 + raw 502 2건이 관측됐다.
#
# ⚠ 에러 캡처는 이 값들과 무관하게 항상 100% 다 — traces 는 성능 추적,
#   profiles 는 프로파일링 샘플링이다. 즉 장애 가시성은 그대로 유지된다.
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Langfuse (LLM 추적) — self-hosted langfuse.luxrobo.net / 단일 인스턴스(3환경 공통) ──
# Sentry 와 동일하게 배포 오버레이로 관리한다 → 서버 .env 누락과 무관하게 항상 주입.
# (SECRET_KEY 는 비공개 키다. 시크릿 매니저로 옮기려면 이 블록을 지우고 서버 시크릿 주입으로 대체.)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://langfuse.luxrobo.net

# ── RAG 프록시 배선 (재사용 코퍼스 영속화 #105) ──
# 메인 앱은 경량 프록시(torch 無)로, 검색·등록은 별도 rag-onprem 스택
# (docker-compose.rag-onprem.yml: MySQL 원천 + Redis Stack HNSW + rag-search)에 위임한다.
# 이 값이 있어야 등록물이 파일이 아닌 MySQL+Redis 에 영속 저장된다(재배포에도 누적).
# 미설정이면 코드 기본값(로컬 sqlite+npy)으로 폴백 → 재배포마다 등록물 소멸.
# host.docker.internal 은 docker-compose.yml 의 extra_hosts(host-gateway)로 리눅스에서도 해석됨.
# 기동·백필·롤백 절차는 deploy/README.md "온프렘 운영 스택" 런북 참조.
RAG_UPSTREAM=http://host.docker.internal:8100

# 사용자 쿼터 — 자정(KST) 리셋. ⚠ 실제 학생 전원에게 적용된다.
#
# 턴 상한 70 (2026-08-21, 2시간 수업 기준으로 산정).
#   이력: 3(2026-07-13 테스트 잔재) → 0(해제) → 70.
#   3 은 학급 수업에서 4번째 프롬프트부터 전원을 차단해 즉시 제거했고, 0(무제한)은
#   한 학생이 공유 자원을 독점하는 걸 못 막아 상한을 다시 세웠다.
#
# 왜 70 인가 — 실측 지연으로 역산한 "2시간에 물리적으로 가능한 턴 수":
#   되묻기 위주(30s+생각45s)        → 96턴
#   생성 위주·한산(94s+45s)         → 52턴
#   생성 위주·혼잡(160s+45s)        → 35턴
#   실제 수업 흐름(설계5+생성2+수정3 = 작품 1개 10턴 ≈ 18분) → 2시간에 약 67턴
#   즉 70 은 물리적 상한(96)에 가까워 정상 사용자를 막지 않으면서, 자동화·폭주만 끊는다.
#   ⚠ server.py:95 주석의 권장치 20~30 은 '하루 종일' 기준이라 2시간 집중 수업과 밀도가
#     다르다. 30 이면 작품 3개에서 막혀 적극적인 학생이 먼저 차단된다.
#
# 토큰 상한도 함께 올린다 — 서버는 턴/토큰 **둘 중 하나라도** 소진되면 차단하므로
#   (server.py 쿼터 게이트), 토큰 상한을 그대로 두면 턴 70 이 장식이 된다.
#   기본값 2,000,000 에서 실측 가중토큰으로 역산하면:
#     생성 턴만(128,600/턴)        → 15.6턴에서 차단  ← 70 에 한참 못 미침
#     혼합 50/50 (70,707/턴)       → 28.3턴에서 차단
#     되묻기만(12,814/턴)          → 156턴
#   5,000,000 으로 올리면:
#     생성 턴만                    → 38.9턴 (여기서만 토큰이 먼저 걸림 = 폭주 방어 잔존)
#     혼합 50/50                   → 70턴 (턴 상한에 도달) ✅
#     되묻기 위주                  → 70턴 ✅
#   즉 정상 수업(설계·생성·수정 혼합)은 70턴을 다 쓸 수 있고, 생성만 반복하는
#   비정상 패턴은 39턴에서 끊긴다. 1인 최대 $5, 40명 최악 $198(API 환산).
#
# ⚠ CLI 구독 모드에서는 이 값들이 '용량'이 아니라 '공정성' 장치다 — 전 사용자가 구독
#   1계정을 공유하므로, 계정 자체가 소진되면 상한과 무관하게 전원이 막힌다
#   (2026-08-21 실측: 부하 테스트로 실제 소진 → "Claude 사용 한도에 도달했어요").
#   근본 해결은 API 모드 전환(USE_LOCAL_CLAUDE=false).
QUOTA_ENABLED=true
QUOTA_DAILY_MAX_TURNS=70
QUOTA_DAILY_WEIGHTED_TOKENS=5000000
