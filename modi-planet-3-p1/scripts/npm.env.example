# NPM 자동등록용 자격증명 — 이 파일을 scripts/npm.env 로 복사해서 채우세요.
#   cp scripts/npm.env.example scripts/npm.env  &&  vi scripts/npm.env
# scripts/npm.env 는 .gitignore 에 들어있어 커밋되지 않습니다.

# 필수 — NPM 관리자 로그인 (192.168.0.102:81)
NPM_EMAIL=admin@example.com
NPM_PASS=changeme

# 선택 — 도메인 기본인증 계정 (없으면 아이디 'edu' + 비번 자동생성)
#AUTH_USER=edu
#AUTH_PASS=

# 선택 — Let's Encrypt 동의 이메일 (기본 walter.jung@luxrobo.com)
#LE_EMAIL=walter.jung@luxrobo.com

# 선택 — SSL 끄려면 false
#ENABLE_SSL=true
