# 온프렘 배포 설정 — 복사해서 deploy/.env 로 두거나 compose 실행 디렉터리에 .env 로 배치.
#   cp deploy/.env.example .env

# 서비스 포트 (호스트)
PORT=8100

# ── 저장소 백엔드 ───────────────────────────────────────────
# local       : SQLite + 로컬 .npy (기본, 단일 컨테이너 데모)
# mysql_redis : 온프렘 MySQL(원천) + Redis Stack(벡터) — docker-compose.rag-onprem.yml
RAG_BACKEND=local

# 온프렘 운영(mysql_redis)일 때만 필요:
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=edu_agent
MYSQL_USER=edu
MYSQL_PASSWORD=change-me-app-password
# 앱→DB 연결(컨테이너 네트워크 기준). 외부 MySQL이면 host를 엔드포인트로.
# DATABASE_URL=mysql+pymysql://edu:<MYSQL_PASSWORD>@mysql:3306/edu_agent
# VECTOR_REDIS_URL=redis://redis:6379/0

# ── 유사도 게이팅 임계값 (등록 vs 가져오기) ─────────────────
# 결합 점수(0~1) 기준. 히트율(%)을 아래 값으로 캘리브레이션한다.
#   top1 ≥ TAU_REUSE            → reuse    (가져오기: 재사용, 캐시 히트)
#   TAU_NEAR ≤ top1 < TAU_REUSE → review   (근접: 검수 후 재사용)
#   top1 < TAU_NEAR             → register (콜드셀: 신규 생성 대상)
# 재사용률을 높이려면 임계값을 낮추고, 품질을 조이려면 높인다.
TAU_REUSE=0.62
TAU_NEAR=0.48

# ── 하이브리드 가중치 (합=1 권장) ───────────────────────────
# centroid(개념 임베딩 평균)는 패러프레이즈에 강함(gold 6/8) → 비중 크게.
W_VEC=0.4       # 벡터(청크 BGE-m3 의미 유사도)
W_LEX=0.15      # 부분일치(어휘 겹침)
W_CONCEPT=0.45  # 개념 centroid 유사도(개념 정확도 핵심)
